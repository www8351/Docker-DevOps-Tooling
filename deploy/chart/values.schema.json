{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "devops-stack values",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string", "pattern": "^(sha256:[a-f0-9]{64})?$" },
        "pullPolicy": { "enum": ["Always", "IfNotPresent", "Never"] }
      }
    },
    "id": { "type": "integer", "minimum": 1 },
    "resources": {
      "type": "object",
      "required": ["limits"],
      "properties": {
        "requests": { "type": "object" },
        "limits": {
          "type": "object",
          "required": ["cpu", "memory"]
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "port"],
      "properties": {
        "type": { "enum": ["ClusterIP", "NodePort", "LoadBalancer"] },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 }
      }
    },
    "web": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicas", "image", "runAsUser", "runAsGroup", "service", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/image" },
        "runAsUser": { "$ref": "#/definitions/id" },
        "runAsGroup": { "$ref": "#/definitions/id" },
        "service": { "$ref": "#/definitions/service" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    }
  },
  "properties": {
    "global": { "type": "object" },
    "nginx": { "$ref": "#/definitions/web" },
    "httpd": { "$ref": "#/definitions/web" },
    "counter": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicas", "image", "runAsUser", "runAsGroup", "resources"],
      "properties": {
        "enabled": { "type": "boolean" },
        "replicas": { "type": "integer", "minimum": 0 },
        "image": { "$ref": "#/definitions/image" },
        "runAsUser": { "$ref": "#/definitions/id" },
        "runAsGroup": { "$ref": "#/definitions/id" },
        "resources": { "$ref": "#/definitions/resources" }
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string" }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "tests": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkNetworkPolicy"],
      "properties": {
        "checkNetworkPolicy": { "type": "boolean" }
      }
    }
  }
}
