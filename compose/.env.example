# Copy to .env and adjust. Compose reads .env automatically.
# No secrets here: bind addresses and ports only.

# Host addresses the published ports bind to. Loopback by default, so nothing
# is reachable from the network until you opt in. Set WEB_BIND_ADDR=0.0.0.0 to
# expose nginx/httpd; keep ADMIN_BIND_ADDR on loopback unless the admin UIs
# (portainer, prometheus, grafana) sit behind your own auth or VPN.
WEB_BIND_ADDR=127.0.0.1
ADMIN_BIND_ADDR=127.0.0.1

# Host ports
NGINX_PORT=8080
HTTPD_PORT=8081
PORTAINER_PORT=9000

# Observability profile (docker compose --profile observability up)
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# Admin passwords are not set here. Run scripts/gen-secrets.sh (or
# `task secrets`) to create them under compose/secrets/.

# Image references are pinned by tag and digest directly in
# docker-compose.yml, where Dependabot keeps them current. To run a different
# image, layer an override file: docker compose -f docker-compose.yml -f my.yml
