{
  "title": "Stack Containers",
  "uid": "stack-containers",
  "description": "Containers are labelled by the short id that `docker ps` prints; cAdvisor runs without Docker API access, so names are not available.",
  "schemaVersion": 39,
  "editable": false,
  "timezone": "browser",
  "time": { "from": "now-30m", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "CPU usage per container",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "percentunit" }, "overrides": [] },
      "targets": [
        {
          "expr": "sum by (container_id) (rate(container_cpu_usage_seconds_total{container_id!=\"\"}[2m]))",
          "legendFormat": "{{container_id}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Memory working set per container",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "bytes" }, "overrides": [] },
      "targets": [
        {
          "expr": "container_memory_working_set_bytes{container_id!=\"\"}",
          "legendFormat": "{{container_id}}"
        }
      ]
    },
    {
      "id": 3,
      "title": "nginx requests per second",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "reqps" }, "overrides": [] },
      "targets": [
        {
          "expr": "rate(nginx_http_requests_total[2m])",
          "legendFormat": "requests"
        }
      ]
    },
    {
      "id": 4,
      "title": "nginx active connections",
      "type": "timeseries",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 9 },
      "fieldConfig": { "defaults": { "unit": "short" }, "overrides": [] },
      "targets": [
        {
          "expr": "nginx_connections_active",
          "legendFormat": "active"
        }
      ]
    }
  ]
}
